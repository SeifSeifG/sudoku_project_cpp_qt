{
    "version": 4,
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include/x86_64-linux-gnu/qt6/**",
                "/usr/lib/x86_64-linux-gnu/qt6/mkspecs/linux-g++"
            ],
            "defines": [
                "__auto_type=auto",
                "QT_CORE_LIB",
                "QT_GUI_LIB",
                "QT_WIDGETS_LIB"
            ],
            "compilerPath": "/usr/bin/g++-15",
            "cStandard": "c17",
            "cppStandard": "c++26",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}